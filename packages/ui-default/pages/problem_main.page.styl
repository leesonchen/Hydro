.page--problem_main
.page--problem_category
  .col--checkbox
    width: rem(61px)

  .col--pid
    width: rem(81px)
  
  .col--status
    width: rem(140px)
    position: relative
    border-right: 1px solid $table-border-color

  .col--difficulty
    width: rem(70px)
    text-align: center
  
  &[lang="en"]
    .col--difficulty
      width: rem(95px)

  .col--ac-tried
    width: rem(100px)
    text-align: center
    border-left: 1px solid $table-border-color

  +mobile()
    .col--status,
    .col--tried,
    .col--difficulty
      display: none

    .col--ac
      border-left: 1px solid $table-border-color

.search.search--with-scope
  align-items: stretch
  border: 1px solid $border-1-color
  display: flex
  min-height: 36px

  > .search-query,
  > .search-options
    position: static
    right: auto
    top: auto
    font-size: inherit

  > .search-query
    display: flex
    flex: 1 1 auto
    min-width: 0

    > input
      border: 0
      flex: 1 1 auto
      font-size: rem($font-size-secondary)
      height: 36px
      min-width: 0
      outline: none
      padding: 5px 10px

    > button
      background: #00B4CC
      border: 0
      color: #fff
      cursor: pointer
      flex: 0 0 40px
      font-size: rem($font-size-icon)
      height: 36px
      width: 40px

      &:hover
        background: #0099aa

  > .search-options
    display: flex
    min-width: 0

    > select.search-sort
      background: $input-background-color
      border: 0
      border-left: 1px solid $table-border-color
      cursor: pointer
      font-size: rem($font-size-secondary)
      height: 36px
      padding: 0 8px
      position: static
      width: 110px

    > label.search-filter
      align-items: center
      background: $input-background-color
      border-left: 1px solid $table-border-color
      color: $label-color
      display: flex
      font-size: rem($font-size-small)
      gap: 4px
      height: 36px
      margin: 0
      padding: 0 10px
      white-space: nowrap

      input
        margin: 0

    > div[data-fragment-id="problem_stat"]
      align-items: center
      border-left: 1px solid $table-border-color
      color: $text-2-color
      display: flex
      font-size: rem($font-size-secondary)
      padding: 0 12px
      white-space: nowrap

.theme--dark .search.search--with-scope
  border-color: #434343

  > .search-options > select.search-sort,
  > .search-options > label.search-filter
    background: #1f1f1f
    border-color: #434343
    color: #eee

  > .search-options > div[data-fragment-id="problem_stat"]
    border-color: #434343
    color: #bdbdbd

@media (max-width: 1399px)
  .search.search--with-scope
    display: block

    > .search-query
      height: 36px

    > .search-options
      border-top: 1px solid $table-border-color
      flex-wrap: wrap

      > select.search-sort,
      > label.search-filter,
      > div[data-fragment-id="problem_stat"]
        border-bottom: 1px solid $table-border-color
        flex: 1 1 auto
        min-width: 0

      > label.search-filter
        height: auto
        min-height: 36px
        white-space: normal

      > div[data-fragment-id="problem_stat"]
        justify-content: center

@media (max-width: 720px)
  .page--problem_main,
  .page--problem_category
    .col--status,
    .col--difficulty
      display: none

    .col--ac-tried
      width: rem(90px)

@media (max-width: 600px)
  .page--problem_main,
  .page--problem_category
    .pager
      overflow-x: auto
      white-space: nowrap
      -webkit-overflow-scrolling: touch

    .section__table-container .data-table
      min-width: 360px

    .edit-mode .section__table-container .data-table
      min-width: 600px


.widget--category-filter
  &__category
    margin-bottom: rem(6px)

  &__drop
    position: relative
    font-size: rem($font-size-small)
    width: rem(230px)
    padding: rem(10px)
    margin-right: rem(10px)
    background: $menu-drop-bg-color
    box-shadow: $menu-drop-shadow

    &:before
      content: ''
      display: block
      position: absolute
      width: 0
      height: 0
      border: rem($menu-drop-triangle-size) solid transparent
      border-top-color: #FFF
      border-left-color: #FFF
      box-shadow: $menu-drop-triangle-shadow
      transform: rotate(135deg)
      transform-origin: 0 0
      pointer-events: none
      left: 100%
      top: 50%
      margin-left: rem(floor($menu-drop-triangle-size * 1.414))

  &__subcategory
    margin: rem(2px)
    display: inline-block
  
  &__tag
    display: inline-block
    padding: rem(5px 6px)

    &:hover
      color: #FFF
      background: $primary-color
      text-decoration: none

    &.selected
      color: #FFF
      background: $secondary-color

.drop-target-attached-right .widget--category-filter__drop
  margin-right: 0
  margin-left: rem(10px)

  &:before
    transform-origin: 100% 0
    transform: rotate(-45deg)
    left: auto
    right: 100%
    margin-left: 0
    margin-right: 0
    margin-top: rem(floor($menu-drop-triangle-size * -1.414))


.display-mode .display-mode-hide,
.edit-mode .edit-mode-hide,
.hide-problem-tag .notag--hide,
.tag--hide
  display: none

.hide-problem-tag .tag--hide
  display: block

.toggle-tag
  float: right

.data-table > tbody > tr
  height: 40.15px

.data-table > thead > tr
  height: 54.9px

.search-container
  padding-bottom: 0

  .title
    margin-bottom: rem(5px)

  .dialog-button
    font-size: rem($font-size-secondary)
    display: inline-block
    padding: rem(5px 6px)
    margin-bottom: rem(5px)

.search-tag__item
  display: inline-block
  padding: rem(5px 6px)
  font-size: rem($font-size-secondary)
  margin-bottom: rem(5px)

  &:hover    
    color: #555;
    background: #f4f4f4;
    text-decoration: none

  &.selected
    color: #FFF
    background: $primary-color !important

  &.hide 
    display: none
    opacity: 0    

.category-filter__header
  [data-category-container].list
    overflow-x: auto

  .list
    .list__item
      padding: 12px 12px
      cursor: pointer
      margin: 0px 10px
      background: #eeeff3
      min-width: 90px
      text-align: center
      position: relative

      &.selected
        background: $primary-color
        color: #FFF
        font-weight: bold

    .list__item::first
      margin-left: 0px

.category-filter__body
  margin: 12px 10px 0 10px
  background: #f7f7f7
  max-height: rem(400px)
  overflow-y: auto  

  .subcategory-container
    &.hide
      display: none
      opacity: 0

    & h2
      font-size: rem($font-size)
      font-weight: bold
      margin-bottom: 16px

    .divider
      border-bottom: 1px solid #e5e5e5
      margin: rem(16px) 0

    .search-tag__item
      background: #eaeaea;

.search
  width: 100%
  position: relative
  display: flex

.search > input
  width: 100%
  border: 1px solid #cccccc
  border-right: none
  padding: 5px
  height: 36px
  outline: none
  color: #000000

.search > button
  width: 37px
  height: 36px
  border: 1px solid #00B4CC
  background: #00B4CC
  text-align: center
  color: #fff
  cursor: pointer
  font-size: 20px

.search > div
  position: absolute
  right: 170px
  top: 10px
  font-size: rem(17px)

.search-sort
  position: absolute
  border: none
  top: 1px
  height: 34px
  right: 37px
  color: #000000
  cursor: pointer
  width: 120px
