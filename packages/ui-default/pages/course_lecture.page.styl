.course-mermaid
  margin: 1.2rem 0
  overflow-x: auto
  overflow-y: hidden
  padding: 0.25rem 0
  text-align: center
  -webkit-overflow-scrolling: touch

  svg
    display: block
    height: auto
    margin: 0 auto
    // Do not scale a wide graph down to the article width. Mermaid's native
    // SVG size keeps node labels readable; the parent scrolls horizontally.
    max-width: none
    min-width: min-content

  @media (max-width: 720px)
    svg
      margin-left: 0
      margin-right: 0

.course-mermaid__error
  color: $fail-color
  margin-bottom: 0.4rem

.page--course_lecture #lecture-main
  > :not(.course-lecture-table-scroll):not(.course-mermaid):not(hr)
    max-width: 100ch

  .course-lecture-table-scroll
    overflow-x: auto
    -webkit-overflow-scrolling: touch

    table
      min-width: 100%
      width: max-content

.course-lecture-edit-float
  align-items: center
  bottom: 30px
  display: flex
  gap: 0.4rem
  margin: 0
  position: fixed
  right: 70px
  white-space: nowrap
  z-index: 100

@media (max-width: 1399px)
  .page--course_lecture
    .section__header .section__tools
      display: flex
      flex-wrap: wrap
      gap: rem(6px)
      margin-top: rem(10px)
      position: static

      .button
        min-height: 36px

@media (max-width: 999px)
  .course-lecture-edit-float
    bottom: 76px
    right: 16px
