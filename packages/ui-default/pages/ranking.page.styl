.page--ranking, .page--homepage
  .col--rank
    width: rem(65px)
    position: relative

  .col--user
    width: rem(280px)

  .col--rp
    width: rem(60px)
    text-align: right

  .col--detail
    width: rem(50px)
    text-align: center

  &[lang="en"]
    .col--detail
      width: rem(75px)

  .col--ac
    width: rem(50px)
    text-align: center

  &[lang="en"]
    .col--ac
      width: rem(70px)

  .col--bio
    display: block

  td.col--bio
    height: 36px !important

  +mobile()
    .col--bio, .col--detail
      display: none

.page--ranking
  .col--rank
    width: 7%

  .col--user
    width: 18%

  .col--rp
    width: 11%

  .col--rating, .col--events, .col--growth, .col--submit, .col--accept
    width: 7%
    text-align: center

  .col--bio
    width: 29%

  .col--user
    a.user-profile-badge
      display: none

  +mobile()
    .col--rating, .col--events, .col--growth, .col--submit, .col--accept
      display: none
