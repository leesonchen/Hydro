.feedback-dialog .dialog__content
  max-width: calc(100vw - 24px) !important

.feedback-form
  label
    display: block
    margin-top: rem(15px)

  textarea
    display: block
    width: 100%
    resize: vertical

  &__source, &__quote
    overflow-wrap: anywhere

  &__quote
    background: #f5f5f5

  &__error
    color: #d4380d
