diff --git a/packages/hydrooj/src/handler/contest-monitor.ts b/packages/hydrooj/src/handler/contest-monitor.ts
new file mode 100644
index 00000000..f9a3cf78
--- /dev/null
+++ b/packages/hydrooj/src/handler/contest-monitor.ts
@@ -0,0 +1,111 @@
+import { ObjectId } from 'mongodb';
+import { Context } from '../context';
+import { ContestNotAttendedError, ContestNotFoundError, ForbiddenError, ValidationError } from '../error';
+import { PERM } from '../model/builtin';
+import * as contest from '../model/contest';
+import db from '../service/db';
+import { Handler, param, Types } from '../service/server';
+
+type MonitorEventType = 'page_hidden' | 'page_visible' | 'window_blur' | 'window_focus'
+    | 'fullscreen_exit' | 'fullscreen_enter' | 'paste_detected' | 'page_leave' | 'heartbeat';
+
+const eventTypes: MonitorEventType[] = [
+    'page_hidden', 'page_visible', 'window_blur', 'window_focus',
+    'fullscreen_exit', 'fullscreen_enter', 'paste_detected', 'page_leave', 'heartbeat',
+];
+const events = db.collection('contest.monitor' as any);
+const sessions = db.collection('contest.monitor.sessions' as any);
+const retentionMs = 90 * 24 * 60 * 60 * 1000;
+
+export class ContestMonitorHandler extends Handler {
+    @param('tid', Types.ObjectId)
+    async get(domainId: string, tid: ObjectId) {
+        const tdoc = await contest.get(domainId, tid);
+        if (tdoc.monitorMode !== 'browser') throw new ContestNotFoundError(domainId, tid);
+        if (!this.user.own(tdoc) && !this.user.hasPerm(PERM.PERM_EDIT_CONTEST)) throw new ForbiddenError();
+        const [eventDocs, sessionDocs] = await Promise.all([
+            events.find({ domainId, contestTid: tid, eventType: { $ne: 'heartbeat' } } as any)
+                .sort({ serverAt: -1 }).limit(500).toArray(),
+            sessions.find({ domainId, contestTid: tid } as any)
+                .sort({ lastSeenAt: -1 }).limit(500).toArray(),
+        ]);
+        this.response.body = { tdoc, events: eventDocs, sessions: sessionDocs, page_name: 'contest_monitor' };
+        this.response.template = 'contest_monitor.html';
+    }
+
+    @param('tid', Types.ObjectId)
+    @param('eventType', Types.String)
+    @param('sessionId', Types.String)
+    @param('pageInstanceId', Types.String)
+    @param('sequence', Types.Int)
+    async post(domainId: string, tid: ObjectId, eventType: string, sessionId: string, pageInstanceId: string, sequence: number) {
+        const tdoc = await contest.get(domainId, tid);
+        if (tdoc.monitorMode !== 'browser') throw new ContestNotFoundError(domainId, tid);
+        if (!eventTypes.includes(eventType as MonitorEventType)) throw new ValidationError('eventType');
+        if (!/^[a-zA-Z0-9-]{10,100}$/.test(sessionId)
+            || !/^[a-zA-Z0-9-]{10,100}$/.test(pageInstanceId)
+            || !Number.isSafeInteger(sequence) || sequence < 1 || sequence > 10000000) {
+            throw new ValidationError('sessionId');
+        }
+        const status = await contest.getStatus(domainId, tid, this.user._id);
+        if (!status?.attend) throw new ContestNotAttendedError(domainId, tid);
+        if (!contest.isOngoing(tdoc, status)) throw new ForbiddenError('Exam is not active');
+        await this.limitRate('contest_monitor', 60, 150);
+
+        const now = new Date();
+        const expiresAt = new Date(now.getTime() + retentionMs);
+        const key = { domainId, contestTid: tid, uid: this.user._id, sessionId };
+        if (eventType !== 'heartbeat') {
+            // Uniqueness includes pageInstanceId; the page sequence can start at 1 on each navigation.
+            const result = await events.updateOne({ ...key, pageInstanceId, sequence } as any, {
+                $setOnInsert: { eventType, serverAt: now, expiresAt },
+            } as any, { upsert: true });
+            if (!result.upsertedId) {
+                this.response.body = { ok: true, duplicate: true };
+                return;
+            }
+        }
+
+        const previous = await sessions.findOne(key as any) as any;
+        const sessionFields: Record<string, any> = {
+            lastSeenAt: now, lastEventType: eventType, expiresAt,
+        };
+        const removeFields: Record<string, string> = {};
+        let durationMs: number | undefined;
+        if (eventType === 'page_hidden') sessionFields.hiddenSince = now;
+        if (eventType === 'window_blur') sessionFields.blurSince = now;
+        if (eventType === 'page_visible' && previous?.hiddenSince instanceof Date) {
+            durationMs = Math.max(0, now.getTime() - previous.hiddenSince.getTime());
+            removeFields.hiddenSince = '';
+        }
+        if (eventType === 'window_focus' && previous?.blurSince instanceof Date) {
+            durationMs = Math.max(0, now.getTime() - previous.blurSince.getTime());
+            removeFields.blurSince = '';
+        }
+        if (typeof durationMs === 'number') {
+            await events.updateOne({ ...key, pageInstanceId, sequence } as any, { $set: { durationMs } } as any);
+        }
+        await sessions.updateOne(key as any, {
+            $set: sessionFields,
+            ...(Object.keys(removeFields).length ? { $unset: removeFields } : {}),
+        } as any, { upsert: true });
+        this.response.body = { ok: true };
+    }
+}
+
+export async function apply(ctx: Context) {
+    ctx.on('domain/delete', (domainId) => Promise.all([
+        events.deleteMany({ domainId } as any),
+        sessions.deleteMany({ domainId } as any),
+    ]));
+    await ctx.db.ensureIndexes(events,
+        { key: { domainId: 1, contestTid: 1, uid: 1, sessionId: 1, pageInstanceId: 1, sequence: 1 }, name: 'monitorDedupe', unique: true },
+        { key: { domainId: 1, contestTid: 1, serverAt: -1 }, name: 'monitorListing' },
+        { key: { expiresAt: 1 }, name: 'monitorEventsExpire', expireAfterSeconds: 0 },
+    );
+    await ctx.db.ensureIndexes(sessions,
+        { key: { domainId: 1, contestTid: 1, uid: 1, sessionId: 1 }, name: 'monitorSession', unique: true },
+        { key: { domainId: 1, contestTid: 1, lastSeenAt: -1 }, name: 'monitorLiveSessions' },
+        { key: { expiresAt: 1 }, name: 'monitorSessionsExpire', expireAfterSeconds: 0 },
+    );
+}
